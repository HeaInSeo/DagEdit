<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <TargetFramework>net8.0</TargetFramework>
    <!-- 정적 분석 설정 -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <!-- 기존 코드 위반으로 인해 경고를 에러로 처리하지 않음. 점진적으로 0건 달성 목표. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.0.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.0.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.0.0" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <!--PrivateAssets="all": 이 패키지의 의존성이 참조 프로젝트(Tests, Benchmarks)로 전파되지 않도록 격리-->
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ReactiveUI" Version="19.6.1" />
    <PackageReference Include="System.Reactive" Version="6.0.0" />
    <!-- 정적 분석기 -->
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.507">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>


  <!-- Phase 1 Viewer spike: VirtualCanvas.Core (UI 의존 없음, spatial primitives만) -->
  <!-- G-0 Viewer wiring: VirtualCanvas.Avalonia (Avalonia Control, UI 의존 있음) -->
  <ItemGroup>
    <ProjectReference Include="external/virtualcanvas-avalonia/src/VirtualCanvas.Core/VirtualCanvas.Core.csproj" />
    <ProjectReference Include="external/virtualcanvas-avalonia/src/VirtualCanvas.Avalonia/VirtualCanvas.Avalonia.csproj" />
  </ItemGroup>

  <!-- 테스트 프로젝트에서 internal 타입(NodeViewItem 등) 접근 허용 -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DagEdit.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <UpToDateCheckInput Remove="Styles.axaml" />
  </ItemGroup>

  <!-- tests/, benchmarks/, VirtualCanvas_ref/, external/ 는 별도 프로젝트/참조용이므로 메인 프로젝트에서 명시적 제외 -->
  <!-- VirtualCanvas_ref: WPF 의존 참조 코드 — Avalonia 프로젝트에서 컴파일 불가 -->
  <!-- external/: git submodule (VCA) — 별도 csproj가 있으므로 여기서 직접 컴파일/임베드하지 않음 -->
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="benchmarks/**/*.cs" />
    <Compile Remove="VirtualCanvas_ref/**/*.cs" />
    <Compile Remove="external/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Remove="external/**" />
    <AvaloniaXaml Remove="external/**" />
    <EmbeddedResource Remove="external/**" />
    <None Remove="external/**" />
    <Content Remove="external/**" />
  </ItemGroup>
</Project>
