<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="675"
        x:Class="DagEdit.MainWindow"
        Title="DagEdit"
        xmlns:controls="using:DagEdit"
        xmlns:vca="using:VirtualCanvas.Avalonia.Controls"
        x:CompileBindings="True">
    <!-- G-0 Viewer wiring: 상단 3/5 = DagEditor, 구분선, 하단 2/5 = VCA viewer (read-only) -->
    <Grid RowDefinitions="3*,2,2*">
        <controls:DagEditor x:Name="EditorTester" Grid.Row="0" />
        <Border Grid.Row="1" Background="#444444" />
        <!-- H-0: viewer panel — VCA + debug stats overlay -->
        <Grid Grid.Row="2">
            <vca:VirtualCanvas x:Name="ViewerCanvas" IsVirtualizing="False" />
            <!-- H-0: debug stats overlay (read-only, top-right corner) -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="#BB000000" Margin="4" Padding="6,3"
                    IsHitTestVisible="False">
                <TextBlock x:Name="ViewerStatsText"
                           Foreground="White" FontSize="10"
                           Text="VCA viewer — waiting" />
            </Border>
        </Grid>
    </Grid>
</Window>
