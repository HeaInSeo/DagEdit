<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:DagEdit"
        x:DataType="controls:DagEditorViewModel"
        x:CompileBindings="True">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
            <controls:DagEditor />
        </Border>
    </Design.PreviewWith>
    <Style Selector="controls|DagEditor">
        <Setter Property="BorderBrush"
                Value="DodgerBlue" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="2" />
        <Setter Property="ItemsSource"
                Value="{Binding Items}" />
        <Setter Property="PendingConnectionTemplate">
            <DataTemplate>
                <!-- ViewportLocation/Scale는 DagEditor 속성을 통해 바인딩.
                     DagEditor 속성은 ViewModel과 동기화되므로 Feature 3 계약을 유지한다. -->
                <controls:PendingConnection SourceAnchor="{Binding $parent[controls:DagEditor].SourceAnchor}"
                                            TargetAnchor="{Binding $parent[controls:DagEditor].TargetAnchor}"
                                            IsVisible="{Binding $parent[controls:DagEditor].IsVisiblePendingConnection}"
                                            ViewportLocation="{Binding $parent[controls:DagEditor].ViewportLocation}"
                                            ViewportScale="{Binding $parent[controls:DagEditor].ViewportScale}" />
            </DataTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <!-- Feature 3: DagEditorCanvas의 뷰포트 바인딩을 ViewModel로 변경 -->
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="10">
                    <Canvas x:Name="PART_TopLayer" Background="{DynamicResource SmallGridLinesBrush}">
                        <ItemsPresenter x:Name="PART_ItemsPresenter">
                            <ItemsPresenter.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:DagEditorCanvas x:Name="PART_ItemsHost"
                                                              ViewportLocation="{Binding ViewportLocation}"
                                                              Scale="{Binding ViewportScale}" />
                                </ItemsPanelTemplate>
                            </ItemsPresenter.ItemsPanel>
                        </ItemsPresenter>
                        <ContentPresenter ContentTemplate="{TemplateBinding PendingConnectionTemplate}"
                                          Content="{TemplateBinding PendingConnection}" />
                    </Canvas>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Feature 1: 선택된 노드 시각 피드백 (SelectingItemsControl :selected 의사 클래스) -->
    <Style Selector="controls|Node:selected /template/ Border">
        <Setter Property="BorderBrush" Value="CornflowerBlue" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
</Styles>
